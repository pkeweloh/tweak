MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example
# Development only; docker-compose.prod.yml builds it from the credentials above
DATABASE_URL=mongodb://root:example@mongodb:27017/tweak?authSource=admin
BACKEND_URI=http://backend:1337
JWT_TOKEN=your_jwt_secret_here
APP_DOMAIN=tweak.example.com
# SIGNUP_ENABLED=false
# CORS_ORIGINS=http://localhost:4200
